# Copy this file to ".env" (or ".env.local"), fill it in, then run: npm run dev
# Restart "npm run dev" after every change to this file.

# ---------------- MQTT (live data + control, used by the browser) ----------------
# HiveMQ console -> your cluster -> Overview: WebSocket URL, port 8884, path /mqtt
NEXT_PUBLIC_MQTT_URL=wss://xxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud:8884/mqtt
# HiveMQ console -> Access Management: a SEPARATE login for the dashboard.
# Note: NEXT_PUBLIC_ values are visible in the browser. Fine for a demo.
NEXT_PUBLIC_MQTT_USERNAME=dashboard
NEXT_PUBLIC_MQTT_PASSWORD=change-me

# ---------------- Database (history, used only by the server) ----------------
# Supabase -> your project -> "Connect" button (top) -> "Transaction pooler" -> copy the URI
# and put your database password in place of [YOUR-PASSWORD]. It looks like:
# postgresql://postgres.abcdefghijkl:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# The schema that holds the tables (created by database/schema.sql)
DB_SCHEMA=piyusem

# ---------------- ESP32 upload key ----------------
# Any long random string. Put the SAME value in the ESP32's secrets.h (INGEST_KEY).
INGEST_KEY=change-me-to-a-long-random-string

# Tip: leave NEXT_PUBLIC_MQTT_URL empty (or open http://localhost:3000/?demo)
# to run with a simulated device and fake history, no hardware needed.
